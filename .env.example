MONGODB_URI=mongodb+srv://nzoggeivo_db_user:8AnD6dbOYArjGbeQ@cluster0.plptx0f.mongodb.net/?appName=Cluster0?retryWrites=true&w=majority

# Gmail Configuration for Sending Emails
# 1. Enable 2FA on your Gmail account
# 2. Generate App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password

# Admin Email for Order Notifications (optional — orders now go to WhatsApp)
ADMIN_EMAIL=admin@etomidatesite.com

# Admin WhatsApp Number for Direct Orders
# International format, no + or spaces (e.g., 1234567890)
NEXT_PUBLIC_ADMIN_WHATSAPP=1234567890

# Admin Telegram Username for Direct Orders
# Your public Telegram username, with or without @ (e.g., your_shop)
NEXT_PUBLIC_ADMIN_TELEGRAM=your-telegram-username

# JWT Secret for Admin Authentication
# Generate a strong random string (e.g., from: https://randomkeygen.com/)
JWT_SECRET=your-super-secret-jwt-key-change-this
